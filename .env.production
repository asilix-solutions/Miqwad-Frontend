# Production build (Render): route directly to the real backend.
# No Vite dev proxy exists in a production build, so this must be an
# ABSOLUTE URL (see vite.config.ts for the dev-only proxy, and
# src/shared/lib/axios.ts for how this is consumed).
VITE_API_BASE_URL=https://miqwad-test.runasp.net/api
VITE_USE_MOCKS=false
