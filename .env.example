# --- Maqwad Frontend env ---

# Base URL of the .NET API (set to the staging or local backend URL).
# Default keeps the path "/api/v1" so axios works in a same-origin setup.
VITE_API_BASE_URL=/api/v1

# Toggle the in-process mock adapter for /auth/* and /users/me.
# Set to "true" while the backend has not implemented Sprint 1 endpoints.
VITE_USE_MOCKS=true
